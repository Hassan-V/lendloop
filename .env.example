# ==============================================================================
# Next.js + Clerk Authentication
# ==============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Clerk JWT Issuer Domain configured in Clerk Dashboard -> JWT Templates -> Convex
# Also set this in Convex Dashboard Environment Variables
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev

# ==============================================================================
# Convex Backend
# ==============================================================================
# Created automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Convex HTTP Actions endpoint (replace .convex.cloud with .convex.site)
CONVEX_HTTP_URL=https://your-deployment.convex.site

# Optional: email address automatically promoted to "admin" on first sign-in
INITIAL_ADMIN_EMAIL=admin@example.com

# ==============================================================================
# n8n Automation & Bidirectional HMAC Signing
# ==============================================================================
# Generate a strong 32+ byte random hex secret: `openssl rand -hex 32`
# Must be identical in Convex Dashboard Env Vars and Docker Compose .env
N8N_WEBHOOK_HMAC_SECRET=replace_with_64_char_hex_secret

# Public/Docker-reachable URL of n8n workflow 1 Webhook node
N8N_LOAN_EVENT_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-loan-event

# n8n container security & encryption settings
N8N_ENCRYPTION_KEY=replace_with_32_char_random_key
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=replace_with_strong_password
GENERIC_TIMEZONE=UTC
